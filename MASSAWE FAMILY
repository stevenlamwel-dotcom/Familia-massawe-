<script>
// ===== DATA =====
let isAdmin = true; // Set true by default for demo
let currentGender = 'M';
let prevPage = 'page-home';
let currentMemberId = null;

const defaultMembers = [
  { id: 1, jina: 'Massawe Mkuu', jinsia: 'M', kazi: 'Mkulima & Kiongozi', makazi: 'Iringa', simu: '', kizazi: 1, mzaziId: null, maelezo: 'Babu mkuu wa familia yetu yote.' },
  { id: 2, jina: 'Juma Massawe', jinsia: 'M', kazi: 'Mkulima', makazi: 'Iringa', simu: '+255 754 111 222', kizazi: 2, mzaziId: 1, maelezo: '' },
  { id: 3, jina: 'Hassan Massawe', jinsia: 'M', kazi: 'Biashara', makazi: 'Dodoma', simu: '+255 762 333 444', kizazi: 2, mzaziId: 1, maelezo: '' },
  { id: 4, jina: 'Fatuma Massawe', jinsia: 'F', kazi: 'Mwalimu', makazi: 'Dar es Salaam', simu: '+255 713 555 666', kizazi: 2, mzaziId: 1, maelezo: '' },
];

let members = JSON.parse(localStorage.getItem('massawe_members') || JSON.stringify(defaultMembers));
let nextId = Math.max(...members.map(m => m.id), 0) + 1;

const defaultTimeline = [
  { id: 1, year: 1950, event: 'Babu mkuu wa Massawe alizaliwa' },
  { id: 2, year: 1975, event: 'Watoto wa kwanza wa babu mkuu walizaliwa' },
  { id: 3, year: 2000, event: 'Familia ilianza kusambaa mijini' },
];
let timeline = JSON.parse(localStorage.getItem('massawe_timeline') || JSON.stringify(defaultTimeline));
let nextTlId = Math.max(...timeline.map(t => t.id), 0) + 1;

function saveData() {
  localStorage.setItem('massawe_members', JSON.stringify(members));
  localStorage.setItem('massawe_timeline', JSON.stringify(timeline));
}

// ===== NAVIGATION =====
function goPage(pageId, navId) {
  prevPage = document.querySelector('.page.active')?.id || 'page-home';
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(pageId).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  if (navId) document.getElementById(navId)?.classList.add('active');
  if (pageId === 'page-tree') renderTree();
  if (pageId === 'page-wanafamilia') renderMembers();
  if (pageId === 'page-historia') renderTimeline();
  if (pageId === 'page-home') updateDashboard();
  window.scrollTo(0, 0);
}

function goBack() { goPage(prevPage); }

function toggleMore() {
  document.getElementById('more-menu').classList.toggle('open');
}
function closeMore() {
  document.getElementById('more-menu').classList.remove('open');
}
document.addEventListener('click', e => {
  if (!e.target.closest('.nav-more')) closeMore();
});

// ===== DASHBOARD =====
function updateDashboard() {
  document.getElementById('stat-wanafamilia').textContent = members.length;
  document.getElementById('cnt-gen2').textContent = members.filter(m => m.kizazi === 2).length;
  document.getElementById('cnt-gen3').textContent = members.filter(m => m.kizazi === 3).length;
  document.getElementById('cnt-gen4').textContent = members.filter(m => m.kizazi === 4).length;
}

// ===== TREE =====
function renderTree() {
  const container = document.getElementById('tree-container');
  const roots = members.filter(m => !m.mzaziId || m.kizazi === 1);
  container.innerHTML = '';
  roots.forEach(m => {
    container.appendChild(buildNode(m, 0));
  });
}

function buildNode(member, depth) {
  const children = members.filter(m => m.mzaziId === member.id);
  const hasChildren = children.length > 0;
  const div = document.createElement('div');
  div.className = 'tree-node';

  const initials = member.jina.split(' ').map(w => w[0]).join('').substring(0,2).toUpperCase();
  const isRoot = member.kizazi === 1;
  const genClass = ['tag-gen1','tag-gen2','tag-gen3','tag-gen4'][Math.min(member.kizazi-1,3)];

  div.innerHTML = `
    <div class="node-box ${isRoot ? 'root' : ''}" onclick="toggleNode(this, ${member.id}, ${hasChildren})">
      <div class="avatar ${isRoot ? 'root' : (member.jinsia === 'F' ? 'female' : 'male')}">${initials}</div>
      <div class="node-info">
        <h4>${member.jina}</h4>
        <p>${member.kazi || 'Taarifa haijaingizwa'} · <span class="tag ${genClass}" style="font-size:10px;padding:2px 7px;">Kizazi ${member.kizazi}</span></p>
      </div>
      ${hasChildren ? `<i class="ti ti-chevron-right node-arrow"></i>` : `<i class="ti ti-user" style="color:var(--text3);font-size:18px;"></i>`}
    </div>
    <div class="children-container" id="children-${member.id}"></div>
  `;

  // Click on name to see profile
  div.querySelector('.node-info').onclick = (e) => {
    e.stopPropagation();
    showProfile(member.id);
  };

  return div;
}

function toggleNode(el, memberId, hasChildren) {
  if (!hasChildren) { showProfile(memberId); return; }
  const container = document.getElementById('children-' + memberId);
  const arrow = el.querySelector('.node-arrow');

  if (container.classList.contains('open')) {
    container.classList.remove('open');
    el.classList.remove('expanded');
    if (arrow) arrow.classList.remove('down');
  } else {
    container.innerHTML = '';
    const children = members.filter(m => m.mzaziId === memberId);
    children.forEach(child => container.appendChild(buildNode(child, 1)));
    container.classList.add('open');
    el.classList.add('expanded');
    if (arrow) arrow.classList.add('down');
  }
}

// ===== PROFILE =====
function showProfile(memberId) {
  const m = members.find(x => x.id === memberId);
  if (!m) return;

  const parent = m.mzaziId ? members.find(x => x.id === m.mzaziId) : null;
  const children = members.filter(x => x.mzaziId === memberId);
  const initials = m.jina.split(' ').map(w => w[0]).join('').substring(0,2).toUpperCase();

  let childrenHtml = '';
  if (children.length > 0) {
    childrenHtml = children.map(c => `
      <div class="family-link" onclick="showProfile(${c.id})">
        <i class="ti ti-user"></i> ${c.jina}
        <i class="ti ti-chevron-right" style="margin-left:auto"></i>
      </div>
    `).join('');
  } else {
    childrenHtml = `<p style="font-size:13px;color:var(--text3)">Watoto hawajaingizwa</p>`;
  }

  document.getElementById('profile-content').innerHTML = `
    <div class="profile-hero">
      <div class="profile-avatar">${initials}</div>
      <h2>${m.jina}</h2>
      <p>${m.kazi || 'Kazi haijulikani'} · ${m.makazi || 'Mahali haijulikani'}</p>
    </div>

    <div style="margin-top:16px;">
      ${isAdmin ? `<button class="btn btn-secondary" style="margin-bottom:14px;" onclick="openEditMember(${m.id})"><i class="ti ti-edit"></i> Hariri Taarifa</button>` : ''}

      <div class="card">
        <div class="card-title"><i class="ti ti-info-circle"></i> Taarifa za Msingi</div>
        <div class="info-row"><i class="ti ti-user"></i><div><div class="info-label">Jina</div><div class="info-val">${m.jina}</div></div></div>
        ${m.simu ? `<div class="info-row"><i class="ti ti-phone"></i><div><div class="info-label">Simu</div><div class="info-val"><a href="tel:${m.simu}" style="color:var(--green)">${m.simu}</a></div></div></div>` : ''}
        ${m.kazi ? `<div class="info-row"><i class="ti ti-briefcase"></i><div><div class="info-label">Kazi</div><div class="info-val">${m.kazi}</div></div></div>` : ''}
        ${m.makazi ? `<div class="info-row"><i class="ti ti-map-pin"></i><div><div class="info-label">Makazi</div><div class="info-val">${m.makazi}</div></div></div>` : ''}
        <div class="info-row"><i class="ti ti-git-branch"></i><div><div class="info-label">Kizazi</div><div class="info-val">Kizazi cha ${m.kizazi}</div></div></div>
        ${m.maelezo ? `<div class="info-row"><i class="ti ti-notes"></i><div><div class="info-label">Maelezo</div><div class="info-val">${m.maelezo}</div></div></div>` : ''}
      </div>

      ${parent ? `
      <div class="card">
        <div class="card-title"><i class="ti ti-users"></i> Wazazi</div>
        <div class="family-link" onclick="showProfile(${parent.id})">
          <i class="ti ti-user"></i> ${parent.jina}
          <i class="ti ti-chevron-right" style="margin-left:auto"></i>
        </div>
      </div>` : ''}

      <div class="card">
        <div class="card-title"><i class="ti ti-heart"></i> Watoto (${children.length})</div>
        ${childrenHtml}
        ${isAdmin ? `<button class="btn btn-secondary" style="margin-top:10px;font-size:13px;" onclick="openAddChild(${m.id})"><i class="ti ti-plus"></i> Ongeza Mtoto</button>` : ''}
      </div>
    </div>
  `;

  prevPage = document.querySelector('.page.active')?.id || 'page-home';
  goPage('page-profile');
}

// ===== MEMBERS LIST =====
function renderMembers(filter = '') {
  const list = document.getElementById('members-list');
  const filtered = members.filter(m =>
    m.jina.toLowerCase().includes(filter.toLowerCase()) ||
    (m.kazi || '').toLowerCase().includes(filter.toLowerCase())
  );

  if (filtered.length === 0) {
    list.innerHTML = `<div class="empty-state"><i class="ti ti-users"></i><p>Hakuna mwanafamilia aliyepatikana</p></div>`;
    return;
  }

  list.innerHTML = filtered.map(m => {
    const initials = m.jina.split(' ').map(w => w[0]).join('').substring(0,2).toUpperCase();
    const genClass = ['tag-gen1','tag-gen2','tag-gen3','tag-gen4'][Math.min(m.kizazi-1,3)];
    return `
      <div class="member-item" onclick="showProfile(${m.id})">
        <div class="avatar ${m.jinsia === 'F' ? 'female' : 'male'}" style="width:42px;height:42px;">${initials}</div>
        <div class="member-info">
          <h4>${m.jina}</h4>
          <p>${m.kazi || 'Kazi haijulikani'} · <span class="tag ${genClass}" style="font-size:10px;padding:2px 7px;">Kizazi ${m.kizazi}</span></p>
        </div>
        ${isAdmin ? `<div class="member-actions" onclick="event.stopPropagation()">
          <div class="btn-icon" onclick="openEditMember(${m.id})"><i class="ti ti-edit"></i></div>
          <div class="btn-icon" onclick="confirmDelete(${m.id})" style="color:#D85A30"><i class="ti ti-trash"></i></div>
        </div>` : ''}
      </div>
    `;
  }).join('');
}

function filterMembers(val) { renderMembers(val); }

// ===== MEMBER MODAL =====
function openAddMember(parentId = null) {
  document.getElementById('modal-member-title').textContent = 'Ongeza Mwanafamilia';
  document.getElementById('edit-member-id').value = '';
  document.getElementById('m-jina').value = '';
  document.getElementById('m-simu').value = '';
  document.getElementById('m-kazi').value = '';
  document.getElementById('m-makazi').value = '';
  document.getElementById('m-maelezo').value = '';
  setGender('M');
  populateParentSelect(parentId);
  openModal('modal-member');
}

function openAddChild(parentId) {
  openAddMember(parentId);
  document.getElementById('modal-member-title').textContent = 'Ongeza Mtoto';
  const parent = members.find(m => m.id === parentId);
  if (parent) {
    document.getElementById('m-kizazi').value = Math.min(parent.kizazi + 1, 4);
  }
}

function openEditMember(id) {
  const m = members.find(x => x.id === id);
  if (!m) return;
  document.getElementById('modal-member-title').textContent = 'Hariri Taarifa';
  document.getElementById('edit-member-id').value = id;
  document.getElementById('m-jina').value = m.jina;
  document.getElementById('m-simu').value = m.simu || '';
  document.getElementById('m-kazi').value = m.kazi || '';
  document.getElementById('m-makazi').value = m.makazi || '';
  document.getElementById('m-maelezo').value = m.maelezo || '';
  document.getElementById('m-kizazi').value = m.kizazi;
  setGender(m.jinsia);
  populateParentSelect(m.mzaziId);
  document.getElementById('m-mzazi').value = m.mzaziId || '';
  openModal('modal-member');
}

function populateParentSelect(selectedId) {
  const sel = document.getElementById('m-mzazi');
  sel.innerHTML = '<option value="">-- Chagua mzazi --</option>';
  members.forEach(m => {
    const opt = document.createElement('option');
    opt.value = m.id;
    opt.textContent = m.jina + ' (Kizazi ' + m.kizazi + ')';
    if (m.id == selectedId) opt.selected = true;
    sel.appendChild(opt);
  });
}

function setGender(g) {
  currentGender = g;
  document.getElementById('gb-m').classList.toggle('active', g === 'M');
  document.getElementById('gb-f').classList.toggle('active', g === 'F');
}

function saveMember() {
  const jina = document.getElementById('m-jina').value.trim();
  if (!jina) { alert('Tafadhali ingiza jina!'); return; }

  const editId = document.getElementById('edit-member-id').value;
  const data = {
    jina,
    jinsia: currentGender,
    simu: document.getElementById('m-simu').value.trim(),
    kazi: document.getElementById('m-kazi').value.trim(),
    makazi: document.getElementById('m-makazi').value.trim(),
    maelezo: document.getElementById('m-maelezo').value.trim(),
    kizazi: parseInt(document.getElementById('m-kizazi').value),
    mzaziId: parseInt(document.getElementById('m-mzazi').value) || null,
  };

  if (editId) {
    const idx = members.findIndex(m => m.id == editId);
    if (idx !== -1) members[idx] = { ...members[idx], ...data };
  } else {
    data.id = nextId++;
    members.push(data);
  }

  saveData();
  closeModal('modal-member');
  renderMembers();
  updateDashboard();

  if (editId && document.getElementById('page-profile').classList.contains('active')) {
    showProfile(parseInt(editId));
  }
}

function confirmDelete(id) {
  const m = members.find(x => x.id === id);
  if (!m) return;
  if (confirm(`Futa "${m.jina}" kweli kweli?`)) {
    members = members.filter(x => x.id !== id);
    members.forEach(x => { if (x.mzaziId === id) x.mzaziId = null; });
    saveData();
    renderMembers();
    updateDashboard();
  }
}

// ===== HISTORIA =====
function renderTimeline() {
  const sorted = [...timeline].sort((a,b) => a.year - b.year);
  document.getElementById('timeline-list').innerHTML = sorted.map(t => `
    <div class="timeline-item">
      <span class="timeline-year">${t.year}</span>
      <div class="timeline-dot"></div>
      <div class="timeline-content">${t.event}
        ${isAdmin ? `<span onclick="deleteTimeline(${t.id})" style="color:#D85A30;margin-left:8px;cursor:pointer;font-size:12px;"><i class="ti ti-trash"></i></span>` : ''}
      </div>
    </div>
  `).join('');
}

function editHistoria(section) {
  if (!isAdmin) { alert('Unahitaji kuwa admin kuhariri!'); return; }
  document.getElementById('modal-historia-title').textContent = 'Hariri Historia';
  document.getElementById('historia-section-id').value = section;
  document.getElementById('historia-text-input').value = document.getElementById('hist-' + section)?.textContent || '';
  openModal('modal-historia');
}

function saveHistoria() {
  const section = document.getElementById('historia-section-id').value;
  const text = document.getElementById('historia-text-input').value.trim();
  if (document.getElementById('hist-' + section)) {
    document.getElementById('hist-' + section).textContent = text;
  }
  if (section === 'asili') {
    document.getElementById('historia-muhtasari').textContent = text.substring(0, 180) + '...';
  }
  closeModal('modal-historia');
}

function openAddTimeline() {
  if (!isAdmin) { alert('Unahitaji kuwa admin!'); return; }
  document.getElementById('edit-timeline-id').value = '';
  document.getElementById('tl-year').value = '';
  document.getElementById('tl-event').value = '';
  openModal('modal-timeline');
}

function saveTimeline() {
  const year = parseInt(document.getElementById('tl-year').value);
  const event = document.getElementById('tl-event').value.trim();
  if (!year || !event) { alert('Jaza mwaka na tukio!'); return; }
  timeline.push({ id: nextTlId++, year, event });
  saveData();
  closeModal('modal-timeline');
  renderTimeline();
}

function deleteTimeline(id) {
  if (confirm('Futa tukio hili?')) {
    timeline = timeline.filter(t => t.id !== id);
    saveData();
    renderTimeline();
  }
}

// ===== PHOTOS =====
function addPhoto(input) {
  if (!input.files[0]) return;
  const reader = new FileReader();
  reader.onload = e => {
    const grid = document.getElementById('photo-grid');
    const item = document.createElement('div');
    item.className = 'photo-item';
    item.innerHTML = `<img src="${e.target.result}" alt="Picha ya familia">`;
    grid.prepend(item);
  };
  reader.readAsDataURL(input.files[0]);
}

// ===== ADMIN =====
function showAdminLogin() {
  if (isAdmin) {
    isAdmin = false;
    alert('Umetoka kama Admin');
    renderMembers();
    return;
  }
  openModal('modal-admin');
}

function checkAdmin() {
  const pass = document.getElementById('admin-pass').value;
  if (pass === 'massawe2024') {
    isAdmin = true;
    closeModal('modal-admin');
    alert('Umeingia kama Admin!');
  } else {
    alert('Nenosiri si sahihi!');
  }
}

// ===== MODALS =====
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', e => {
    if (e.target === overlay) overlay.classList.remove('open');
  });
});

